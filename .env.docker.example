# ============================================
# StarMind Docker 环境变量配置
# 复制此文件为 .env 并填入你的值
# ============================================

# ===== 必填配置 =====

# GitHub Personal Access Token
# 创建地址: https://github.com/settings/tokens/new
# 需要权限: repo (读取仓库), read:user (读取用户信息)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 认证密钥（用户登录系统必需）
# 生成命令: openssl rand -hex 32
# 示例: a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890
JWT_SECRET_KEY=

# 数据加密密钥（保护用户 GitHub/OpenAI Token）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 示例: abcdefghij1234567890abcdefghij1234567890abc=
# 注意: 必须是 44 字符的 Fernet 密钥
ENCRYPTION_KEY=

# OpenAI API Key
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 前端访问地址（用于生成分享链接和 OAuth 回调）
# 本地开发: http://localhost:5173
# 生产环境: https://your-domain.com
FRONTEND_BASE_URL=http://localhost:5173

# ===== GitHub OAuth 配置（可选）=====
# 用于支持 GitHub 账号登录
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL: {FRONTEND_BASE_URL}/auth/callback
# 留空则禁用 GitHub 登录（用户仍可使用邮箱密码注册登录）

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# ===== OpenAI 配置（有默认值）=====

# API 地址（如使用兼容 API 可修改，如 Azure OpenAI 或本地模型）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v2

# ===== GitHub 同步配置 =====

# 并发数（根据网络情况调整）
GITHUB_SYNC_PAGE_CONCURRENCY=4
GITHUB_README_CONCURRENCY=8

# ===== AI 分析配置 =====

# 并发数（建议 1-3，避免 API 限流）
AI_ANALYSIS_CONCURRENCY=1
# 请求间隔（秒），避免 API 限流
AI_ANALYSIS_REQUEST_DELAY_SECONDS=0.5

# ===== 聊天检索配置 =====

# 相似度阈值 (0.0-1.0)，越高越严格
CHAT_SIMILARITY_THRESHOLD=0.5
# 是否启用 LLM 二次过滤
CHAT_LLM_FILTER_ENABLED=true

# ===== 快速生成密钥命令 =====
#
# JWT 密钥:
#   openssl rand -hex 32
#
# 加密密钥:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 或一键生成两个密钥:
#   echo "JWT_SECRET_KEY=$(openssl rand -hex 32)" && \
#   python -c "from cryptography.fernet import Fernet; print('ENCRYPTION_KEY=' + Fernet.generate_key().decode())"

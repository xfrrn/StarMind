# ============================================
# StarMind Docker 环境变量配置示例
# 复制此文件为 .env 并填入你的值
# ============================================

# ===== 必填配置 =====

# GitHub Personal Access Token
# 创建地址: https://github.com/settings/tokens
# 需要权限: repo (读取仓库), read:user (读取用户信息)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub OAuth (用户登录用)
# 创建 OAuth App: https://github.com/settings/developers
# Authorization callback URL: {FRONTEND_BASE_URL}/auth/callback
# 留空则禁用 GitHub 登录(用户仍可使用邮箱密码注册登录)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# JWT 认证密钥 (用户登录系统必需)
# 生成命令: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-here

# OpenAI API Key
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选配置（有默认值）=====

# OpenAI API 地址（如使用兼容 API 可修改）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型配置
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v2

# GitHub 同步并发数
GITHUB_SYNC_PAGE_CONCURRENCY=4
GITHUB_README_CONCURRENCY=8

# AI 分析配置
AI_ANALYSIS_CONCURRENCY=1
AI_ANALYSIS_REQUEST_DELAY_SECONDS=0.5

# 聊天检索配置
CHAT_SIMILARITY_THRESHOLD=0.5
CHAT_LLM_FILTER_ENABLED=true

# 加密密钥（生产环境建议设置）
# 生成命令: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 前端访问地址（用于生成分享链接和 OAuth 回调）
# 示例: http://localhost:5173 或 https://your-domain.com
FRONTEND_BASE_URL=http://localhost:5173
# Application Configuration
APP_NAME=StarMind
APP_VERSION=1.0.0

# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_API_URL=https://api.github.com
GITHUB_SYNC_PAGE_CONCURRENCY=4
GITHUB_README_CONCURRENCY=8

# OpenAI API Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MAX_TEXT_LENGTH=8000
EMBEDDING_DIMENSION=4096
EMBEDDING_VERSION=v2
EMBEDDING_METADATA_WEIGHT=0.65
EMBEDDING_README_WEIGHT=0.35
EMBEDDING_SUMMARY_MAX_TOKENS=120
EMBEDDING_README_MAX_TOKENS=1500
AI_ANALYSIS_CONCURRENCY=1
AI_ANALYSIS_REQUEST_DELAY_SECONDS=0.5
AI_ANALYSIS_CHECKPOINT_EVERY=1

# PostgreSQL Database URL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/starmind

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Allow credentials (cookies, authorization headers) in CORS requests
CORS_ALLOW_CREDENTIALS=true
# Allowed HTTP methods for CORS requests
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
# Allowed headers in CORS requests
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Correlation-ID

# Rate Limiting Configuration
# Enable or disable rate limiting globally
RATE_LIMIT_ENABLED=true
# Default rate limit for all endpoints (format: "count/period")
# Periods: second, minute, hour, day
RATE_LIMIT_DEFAULT=100/minute
# Rate limit for GitHub sync operations (prevents API abuse)
RATE_LIMIT_SYNC=5/hour
# Rate limit for chat/search endpoints
RATE_LIMIT_CHAT=20/minute

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: "text" for human-readable logs (development), "json" for structured logs (production)
LOG_FORMAT=text

# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_SYNC_PAGE_CONCURRENCY=4
GITHUB_README_CONCURRENCY=8

# OpenAI API Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v2
EMBEDDING_METADATA_WEIGHT=0.65
EMBEDDING_README_WEIGHT=0.35
EMBEDDING_SUMMARY_MAX_TOKENS=120
EMBEDDING_README_MAX_TOKENS=1500
AI_ANALYSIS_CONCURRENCY=1
AI_ANALYSIS_REQUEST_DELAY_SECONDS=0.5
AI_ANALYSIS_CHECKPOINT_EVERY=1

# Chat Retrieval Filtering
# Similarity threshold (0.0-1.0). Higher = stricter filtering. 0.5 = moderate, 0.7 = strict
CHAT_SIMILARITY_THRESHOLD=0.5
# Enable LLM verification after threshold filtering (true/false)
CHAT_LLM_FILTER_ENABLED=true

# PostgreSQL Database URL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/starmind

# Server
HOST=0.0.0.0
PORT=8000

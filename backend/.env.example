# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required for syncing starred repositories
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_SYNC_PAGE_CONCURRENCY=4
GITHUB_README_CONCURRENCY=8

# GitHub OAuth (for user login with GitHub)
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL: {FRONTEND_BASE_URL}/auth/callback
# Leave empty to disable GitHub OAuth login (users can still use email/password)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# JWT Authentication (required for user login system)
# Generate a secret key with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here

# OpenAI API Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_VERSION=v2
EMBEDDING_METADATA_WEIGHT=0.65
EMBEDDING_README_WEIGHT=0.35
EMBEDDING_SUMMARY_MAX_TOKENS=120
EMBEDDING_README_MAX_TOKENS=1500
AI_ANALYSIS_CONCURRENCY=1
AI_ANALYSIS_REQUEST_DELAY_SECONDS=0.5
AI_ANALYSIS_CHECKPOINT_EVERY=1

# Chat Retrieval Filtering
# Similarity threshold (0.0-1.0). Higher = stricter filtering. 0.5 = moderate, 0.7 = strict
CHAT_SIMILARITY_THRESHOLD=0.5
# Enable LLM verification after threshold filtering (true/false)
CHAT_LLM_FILTER_ENABLED=true

# Security
# Encryption key for sensitive data (Fernet key, 44 characters)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, a temporary key will be generated (not suitable for production)
ENCRYPTION_KEY=

# PostgreSQL Database URL
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/starmind

# Server
HOST=0.0.0.0
PORT=8000
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5179

# Frontend base URL (for generating share links and OAuth callback)
# Examples: http://localhost:5173 or https://your-domain.com
FRONTEND_BASE_URL=http://localhost:5173
